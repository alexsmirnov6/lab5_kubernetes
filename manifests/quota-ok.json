{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "quota-ok",
    "namespace": "lab5"
  },
  "spec": {
    "restartPolicy": "Never",
    "terminationGracePeriodSeconds": 3,
    "nodeSelector": {
      "lab": "compute"
    },
    "containers": [
      {
        "name": "pairs",
        "image": "lab5-pairs:1",
        "imagePullPolicy": "Never",
        "args": [
          "hold"
        ],
        "resources": {
          "requests": {
            "cpu": "400m",
            "memory": "64Mi"
          },
          "limits": {
            "cpu": "400m",
            "memory": "64Mi"
          }
        },
        "env": [
          {
            "name": "S3_ENDPOINT",
            "value": "http://rustfs:9000"
          },
          {
            "name": "AWS_ACCESS_KEY_ID",
            "value": "lab5-access"
          },
          {
            "name": "AWS_SECRET_ACCESS_KEY",
            "value": "lab5-local-secret"
          }
        ]
      }
    ]
  }
}
